{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/delphykmc/pixelscope/blob/handoff/enterprise-iqa-window/enterprise/iqa/handoff_manifest.schema.json",
  "title": "PixelScope approved IQA handoff attestation (external artifact)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "main_base_sha",
    "handoff_sha",
    "contract_revision",
    "approved_tag",
    "reviewed_by",
    "approved_at",
    "transfer_mode",
    "imported_paths",
    "removed_paths",
    "validated_tests"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "main_base_sha": {
      "$ref": "#/$defs/sha"
    },
    "handoff_sha": {
      "$ref": "#/$defs/sha"
    },
    "previous_approved_handoff_sha": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha"
        }
      ]
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "approved_tag": {
      "type": "string",
      "pattern": "^handoff/iqa/v[1-9][0-9]*$"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "transfer_mode": {
      "enum": [
        "manifest-delta",
        "history-merge"
      ]
    },
    "imported_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "git_blob_sha",
          "mode",
          "operation"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/ownedPath"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "git_blob_sha": {
            "$ref": "#/$defs/sha"
          },
          "mode": {
            "enum": [
              "100644",
              "100755"
            ]
          },
          "operation": {
            "enum": [
              "add",
              "update"
            ]
          },
          "previous_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "update"
                }
              }
            },
            "then": {
              "required": [
                "previous_sha256"
              ]
            }
          }
        ]
      }
    },
    "removed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "previous_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/ownedPath"
          },
          "previous_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "validated_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "platform",
          "python",
          "outcome"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "python": {
            "type": "string",
            "minLength": 1
          },
          "qt": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ownedPath": {
      "type": "string",
      "pattern": "^(?:(?:src/pixelscope_enterprise/iqa|tests/enterprise/iqa|docs/enterprise/iqa|enterprise/iqa)/(?:[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*/)*[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*|src/pixelscope_enterprise/__init__\\.py)$"
    }
  }
}
